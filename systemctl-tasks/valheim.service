[Unit]
Description=Valheim Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trajanus
LoadCredential=valheim-password:/etc/valheim/valheim-password
WorkingDirectory=/home/trajanus/valheim
ExecStart="/home/trajanus/valheim/start_valheim.sh"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
